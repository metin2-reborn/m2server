# Copy to .env and fill in every empty value. Do not commit .env.

# PUBLIC_IP is the IPv4 address clients use to reach this Linux host.
PUBLIC_IP=127.0.0.1
DB_USER=metin2

DB_PASSWORD=metin2pw
MARIADB_ROOT_PASSWORD=metin2pw
ADMIN_PASSWORD=admin

# The website (../m2portal) runs beside this stack on the same host, joins its network and uses
# MariaDB as WEB_DB_USER, which can only use the account tables and player.player.
WEB_DB_USER=web
WEB_DB_PASSWORD=
