# Copy to .env and fill in every empty value. Do not commit .env.

# PUBLIC_IP is the IPv4 address clients use to reach this Linux host.
PUBLIC_IP=127.0.0.1
DB_USER=metin2

DB_PASSWORD=metin2pw
MARIADB_ROOT_PASSWORD=metin2pw
ADMIN_PASSWORD=admin

# m2web account API and website. SITE_URL is the website's address (mail links point to its
# pages). JWT_SECRET and SITE_API_KEY need at least 32 bytes each (openssl rand -base64 48); the
# key lets the site pass visitors' addresses to the API's rate limits. MAIL_MODE=log writes mails
# to the web log instead of sending them; MAIL_MODE=smtp needs SMTP_HOST and MAIL_FROM (STARTTLS,
# usually port 587).
SITE_URL=http://localhost:8081
SITE_API_KEY=
JWT_SECRET=
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
